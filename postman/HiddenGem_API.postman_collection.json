							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/register",
